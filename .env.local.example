# Supabase 프로젝트 설정 (Supabase Dashboard > Project Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 (절대 클라이언트에 노출되지 않음). Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# 교사 계정 내부 이메일 및 최초 비밀번호 (scripts/seed-teacher.ts 시드용)
TEACHER_INTERNAL_EMAIL=teacher@stu.internal
TEACHER_INITIAL_PASSWORD=
